# ------------------------------------------------------------------
# AI Future Skills Intelligence Engine - environment configuration
# Copy to `.env` and fill in values for your environment.
# Never commit `.env` to source control.
# ------------------------------------------------------------------

# --- Core ---
# Application environment: development | test | production
NODE_ENV=development
# Port the backend API listens on
PORT=4000
# Public URL of the backend API (used for CORS and links)
BACKEND_URL=http://localhost:4000
# Public URL of the frontend (allowed origin for CORS)
FRONTEND_URL=http://localhost:5173

# --- Database ---
# SQLite (default, zero-dependency local demo):
DATABASE_URL=file:./dev.db
# PostgreSQL (production / deployment). To switch providers, change the
# `provider` in backend/prisma/schema.prisma to "postgresql", set the URL
# below, and re-run `npm run db:migrate`.
# DATABASE_URL=postgresql://user:password@host:5432/skills_intelligence
# DIRECT_URL=postgresql://user:password@host:5432/skills_intelligence

# --- Authentication ---
# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-in-production
# Token lifetime in seconds (default 7 days)
JWT_EXPIRES_IN=604800

# --- AI Provider ---
# Which provider to use: openai | template
# `template` is the deterministic fallback explainer that works offline and
# without an API key (used for local demo and graceful degradation).
AI_PROVIDER=template
# Model identifiers (used only when AI_PROVIDER=openai)
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Key for the OpenAI provider. Keep out of any frontend code.
OPENAI_API_KEY=

# --- RAG / Knowledge ---
# Maximum document size accepted for ingestion (bytes)
MAX_DOCUMENT_SIZE_BYTES=5242880

# --- Observability ---
# Structured logging level: debug | info | warn | error
LOG_LEVEL=info

# --- Seed ---
# Password used for demo accounts created by the seed script
DEMO_SEED_PASSWORD=demo1234
